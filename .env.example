# Copie para .env e ajuste os valores. O arquivo .env nunca deve ser commitado.

# PostgreSQL
POSTGRES_DB=conciliador
POSTGRES_USER=conciliador
POSTGRES_PASSWORD=change-me

# Chave de assinatura do JWT: minimo de 32 caracteres. Gere uma com: openssl rand -base64 48
JWT_KEY=change-me-to-a-random-string-with-at-least-32-characters

# Usuario criado na primeira subida
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@conciliador.local
ADMIN_PASSWORD=change-me

# Portas publicadas na sua maquina
WEB_PORT=8080
API_PORT=5080
